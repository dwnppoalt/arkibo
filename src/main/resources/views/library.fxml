<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="10.0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.arkibo.controllers.LibraryController"
      fx:id="libraryRoot">
   <padding>
      <Insets top="30.0" right="30.0" bottom="30.0" left="30.0"/>
   </padding>
   <children>
      <Label text="My Library" style="-fx-font-size: 26px; -fx-font-weight: bold;"/>
      <Label text="Mock page" style="-fx-font-size: 14px;"/>
      <Label text="Saved and bookmarked theses will appear here." fx:id="libraryLabel"/>
   </children>
</VBox>
