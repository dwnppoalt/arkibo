<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="libraryRoot" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.arkibo.controllers.LibraryController">
   <left>
      <VBox styleClass="library-sidebar" spacing="12.0" BorderPane.alignment="TOP_CENTER">
         <children>
            <Label fx:id="greetingLabel" text="Good day, User!" styleClass="sidebar-greeting" textAlignment="LEFT" wrapText="true" />
            <Label text="Here are your saved theses." styleClass="sidebar-subtitle" textAlignment="LEFT" wrapText="true" />
         </children>
         <padding>
            <Insets top="24.0" right="20.0" bottom="24.0" left="20.0" />
         </padding>
      </VBox>
   </left>
   <center>
      <BorderPane prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER_LEFT">
         <top>
            <HBox alignment="CENTER" prefWidth="200.0" spacing="10.0" BorderPane.alignment="TOP_LEFT">
               <children>
                  <TextField fx:id="searchBarField" onAction="#searchSaved" promptText="Search your saved theses" styleClass="searchBarField" />
                  <Button fx:id="searchBarButton" mnemonicParsing="false" onAction="#searchSaved" styleClass="searchBarButton" text="Search" />
               </children>
               <BorderPane.margin>
                  <Insets />
               </BorderPane.margin>
            </HBox>
         </top>
         <BorderPane.margin>
            <Insets />
         </BorderPane.margin>
         <center>
            <BorderPane prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
               <center>
                  <BorderPane prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
                     <BorderPane.margin>
                        <Insets />
                     </BorderPane.margin>
                     <top>
                        <VBox prefWidth="100.0" BorderPane.alignment="CENTER">
                           <children>
                              <Label text="Search Results" />
                              <Label fx:id="resultsLabel" layoutX="10.0" layoutY="10.0" styleClass="resultsLabel" text="Found 0 results">
                              </Label>
                           </children>
                        </VBox>
                     </top>
                     <center>
                        <ScrollPane fitToWidth="true" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER" VBox.vgrow="ALWAYS">
                           <content>
                              <VBox fx:id="libraryVBox" layoutX="14.0" layoutY="-57.0" prefHeight="200.0" prefWidth="100.0" styleClass="resultsVBox" spacing="12.0" />
                           </content>
                           <BorderPane.margin>
                              <Insets bottom="10.0" top="10.0" />
                           </BorderPane.margin>
                        </ScrollPane>
                     </center>
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
                  </BorderPane>
               </center>
               <BorderPane.margin>
                  <Insets left="10.0" right="10.0" top="10.0" />
               </BorderPane.margin>
            </BorderPane>
         </center>
         <padding>
            <Insets bottom="10.0" top="10.0" />
         </padding>
      </BorderPane>
   </center>
</BorderPane>
