<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="authorRoot" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.arkibo.controllers.AuthorController">
   <left>
      <VBox styleClass="library-sidebar" spacing="12.0" BorderPane.alignment="TOP_CENTER">
         <children>
            <Label fx:id="headingLabel" text="Author Theses" styleClass="sidebar-greeting" textAlignment="LEFT" wrapText="true" />
            <Label text="Browse theses connected to the selected author." styleClass="sidebar-subtitle" textAlignment="LEFT" wrapText="true" />
         </children>
         <padding>
            <Insets top="24.0" right="20.0" bottom="24.0" left="20.0" />
         </padding>
      </VBox>
   </left>
   <center>
      <BorderPane>
         <top>
            <VBox spacing="10.0" BorderPane.alignment="CENTER_LEFT">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="search-controls">
                     <children>
                        <TextField fx:id="searchBarField" HBox.hgrow="ALWAYS" maxWidth="Infinity" onAction="#searchAuthorTheses" promptText="Search theses for this author" styleClass="search-field" />
                        <Button mnemonicParsing="false" onAction="#searchAuthorTheses" styleClass="search-button" text="Search" />
                     </children>
                  </HBox>
                  <VBox spacing="6.0">
                     <children>
                        <Label text="Search Results" />
                        <Label fx:id="resultsLabel" styleClass="resultsLabel" text="0 theses" textOverrun="WORD_ELLIPSIS" wrapText="true" />
                     </children>
                  </VBox>
               </children>
               <BorderPane.margin>
                  <Insets left="10.0" right="10.0" top="10.0" />
               </BorderPane.margin>
            </VBox>
         </top>
         <center>
            <ScrollPane fx:id="authorScrollPane" fitToWidth="true" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
               <content>
                  <VBox fx:id="authorVBox" prefWidth="100.0" styleClass="resultsVBox" spacing="12.0" />
               </content>
               <BorderPane.margin>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </BorderPane.margin>
            </ScrollPane>
         </center>
      </BorderPane>
   </center>
</BorderPane>
