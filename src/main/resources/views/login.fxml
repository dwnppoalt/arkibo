<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="400.0" prefWidth="600.0" stylesheets="@/css/login.css"
   xmlns:fx="http://javafx.com/fxml" fx:controller="org.arkibo.controllers.LoginController" styleClass="background"
   fx:id="login">
   <!-- what's up now -->
   <!-- theree
 -->
   <children>
      <Label alignment="CENTER" prefHeight="34.0" prefWidth="108.0" styleClass="title" text="arkibo" textAlignment="CENTER" />
      <Label alignment="CENTER" styleClass="subtitle" text="CLSU Archives" />
      <Button alignment="CENTER" mnemonicParsing="false" styleClass="button google" fx:id="googleLogin" text="Sign in with Google" onAction="#googleButtonOnClick"/>
      <Label alignment="CENTER" text="or" style="fx-font-size: 12px;" />
      <Button alignment="BOTTOM_CENTER" mnemonicParsing="false" styleClass="button guest" fx:id="guestLogin" text="Sign in as guest" onAction="#guestButtonOnClick"/>
   </children>
</VBox>
   

