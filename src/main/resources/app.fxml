<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.effect.BoxBlur?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>

<StackPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.arkibo.controllers.AppController">
   <children>
   
      <BorderPane prefHeight="200.0" prefWidth="200.0" fx:id="mainContent">
         <center>
            <StackPane fx:id="content" BorderPane.alignment="CENTER" />
         </center>
      </BorderPane>
   <HBox maxWidth="1.7976931348623157E308" prefHeight="0.0" prefWidth="200.0" BorderPane.alignment="CENTER" style="-fx-padding: 10px" pickOnBounds="false">
      <children>
         <Button fx:id="openSidebarButton" mnemonicParsing="false" text="☰" onAction="#toggleSidebar" />
      </children>
   </HBox>
      
      <fx:include fx:id="sidebar" source="components/sidebar.fxml" StackPane.alignment="TOP_LEFT"/>
   </children>
</StackPane>
